# 复制本文件为 .env 后填写真实值。.env 已被 .gitignore 排除，绝不要提交。
# ------------------------------------------------------------------
# 本机 server.js 向边缘推送数据时使用的密钥。
# 必须与 Worker 的 secret 完全一致（同一个值）：
#     cd cf-worker && wrangler secret put EDGE_PUSH_TOKEN
# 生成示例：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PUSH_TOKEN=replace-with-a-long-random-string

# 边缘站点地址（换成你自己的域名，不要带结尾斜杠）
EDGE_ORIGIN=https://your-domain.com

# 平时刷新间隔（分钟）。开奖后会自动切换为每 10 分钟追新期号。
REFRESH_MIN=60

# ------------------------------------------------------------------
# 部署 Worker 时另需 Cloudflare API Token，请作为环境变量临时传入，
# 不要写进 .env，也不要提交：
#     CLOUDFLARE_API_TOKEN=xxx wrangler deploy
# 权限最小集：Account / Workers Scripts: Edit, Workers KV Storage: Edit,
#             Workers Routes: Edit, Zone / Zone Settings: Edit
